# Environment variables for the X-AI Creator application

# X (Twitter) Account Credentials for Browser Automation
# Used by src/browser_fetcher.py for logging into X.
X_USERNAME=""
X_PASSWORD=""

# Gemini API Key
# Used by src/gemini_client.py for generating AI comments.
GEMINI_API_KEY=""

# X (Twitter) API Credentials for Posting
# Used by src/twitter_client.py for posting quote tweets.
# Ensure these are from your X Developer Account (v2 API).
TWITTER_API_KEY=""
TWITTER_API_SECRET_KEY=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""

# Application Settings
# Used by src/main.py for controlling search queries and scheduling.
# SEARCH_QUERY: The query to use when searching for tweets on X.
#               Example: "(\"AI breakthrough\" OR \"innovative AI\") lang:en"
SEARCH_QUERY="(\"AI breakthrough\" OR \"innovative AI\") lang:en"

# SCHEDULE_INTERVAL_HOURS: How often the workflow should run, in hours.
#                         Example: 1 (runs every hour)
SCHEDULE_INTERVAL_HOURS=8

